# 文件名：ai.stoverride

name: AI-双订阅兼容规则

desc: 同时适配 悠兔 与 Flower_SS，AI 走 JP/SG/US，X/YouTube 走 HK

proxy-groups:
  # ==== AI: 日本 / 新加坡 / 美国 ====
  - name: 专线-AI
    type: select
    interval: 300
    include-all: true
    filter: >
      (^JP$)|(^SG$)|(^US$)|
      ((专线|高速隧道).*(日本|新加坡|美国))|
      (((日本|新加坡|美国).*(专线|隧道|IEPL|IPLC|GPT)))|
      ((🇯🇵|🇸🇬|🇺🇸).*(日本|新加坡|美国|IEPL|IPLC|专线))|
      (((Japan|Singapore|United ?States).*(IEPL|IPLC|Premium|Tunnel|GPT)))

  # ==== Streaming: 香港 ====
  - name: 专线-HK
    type: select
    interval: 300
    include-all: true
    filter: >
      (^HK$)|
      ((专线|高速隧道).*(香港))|
      ((香港).*(专线|隧道|IEPL|IPLC))|
      ((🇭🇰).*(香港|IEPL|IPLC|专线))|
      (((Hong ?Kong).*(IEPL|IPLC|Premium|Tunnel)))

rules:
  ########################################################################
  # ❶ OpenAI / Claude / Gemini / Google AI / NotebookLM（走 专线-AI）
  ########################################################################
  - DOMAIN-SUFFIX,openai.com,专线-AI
  - DOMAIN-SUFFIX,chatgpt.com,专线-AI
  - DOMAIN-SUFFIX,oaistatic.com,专线-AI
  - DOMAIN-SUFFIX,oaiusercontent.com,专线-AI

  - DOMAIN-SUFFIX,anthropic.com,专线-AI
  - DOMAIN-SUFFIX,claude.ai,专线-AI
  - DOMAIN-SUFFIX,claude.com,专线-AI
  - DOMAIN-SUFFIX,claudeusercontent.com,专线-AI

  - DOMAIN-SUFFIX,quora.com,专线-AI
  - DOMAIN-SUFFIX,poe.com,专线-AI
  - DOMAIN-SUFFIX,poecdn.net,专线-AI
  - DOMAIN-SUFFIX,openrouter.ai,专线-AI
  - DOMAIN-SUFFIX,huggingface.co,专线-AI

  # NotebookLM
  - DOMAIN-SUFFIX,notebooklm.google.com,专线-AI
  - DOMAIN-SUFFIX,notebooklm.google,专线-AI

  # Gemini / Google AI
  - DOMAIN-SUFFIX,gemini.google.com,专线-AI
  - DOMAIN-SUFFIX,aistudio.google.com,专线-AI
  - DOMAIN-SUFFIX,generativelanguage.googleapis.com,专线-AI
  - DOMAIN-SUFFIX,cloudaicompanion.googleapis.com,专线-AI
  - DOMAIN-SUFFIX,deepmind.com,专线-AI
  - DOMAIN-SUFFIX,deepmind.google,专线-AI
  - DOMAIN-SUFFIX,generativeai.google,专线-AI
  - DOMAIN,ai.google.dev,专线-AI
  - DOMAIN-SUFFIX,proactivebackend-pa.googleapis.com,专线-AI
  - DOMAIN,alkalimakersuite-pa.clients6.google.com,专线-AI
  - DOMAIN,makersuite.google.com,专线-AI

  # Google 相关兜底
  - DOMAIN-SUFFIX,googleapis.com,专线-AI
  - DOMAIN-SUFFIX,googleusercontent.com,专线-AI
  - DOMAIN-SUFFIX,gstatic.com,专线-AI
  - DOMAIN-SUFFIX,google.com,专线-AI
  - DOMAIN-SUFFIX,withgoogle.com,专线-AI
  - DOMAIN-SUFFIX,ggpht.com,专线-AI
  - DOMAIN-SUFFIX,googletagmanager.com,专线-AI
  - DOMAIN-SUFFIX,google-analytics.com,专线-AI
  - DOMAIN-SUFFIX,googlesyndication.com,专线-AI
  - DOMAIN-SUFFIX,doubleclick.net,专线-AI
  - DOMAIN-SUFFIX,g.co,专线-AI
  - DOMAIN-SUFFIX,goo.gl,专线-AI

  ########################################################################
  # ❷ YouTube / X（走 专线-HK）
  ########################################################################
  - DOMAIN-SUFFIX,youtube.com,专线-HK
  - DOMAIN-SUFFIX,ytimg.com,专线-HK
  - DOMAIN-SUFFIX,googlevideo.com,专线-HK
  - DOMAIN-KEYWORD,youtube,专线-HK

  - DOMAIN-SUFFIX,x.com,专线-HK
  - DOMAIN-SUFFIX,twitter.com,专线-HK
  - DOMAIN-SUFFIX,t.co,专线-HK
  - DOMAIN-SUFFIX,twimg.com,专线-HK
  - DOMAIN-SUFFIX,video.twimg.com,专线-HK

  ########################################################################
  # ❸ 其他补充
  ########################################################################
  - DOMAIN-SUFFIX,teracloud.jp,专线-HK
  - DOMAIN-KEYWORD,google,专线-AI
